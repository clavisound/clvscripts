#!/bin/bash
if [ "$1" == "" ]; then
	echo "Usage $0 device [sda, sda0, mmcblk1]"
	echo "optional. Second argument is for seconds."
	exit 1
fi

SECONDS=$2
if [ "$2" == "" ]; then
	SECONDS=60
fi

echo wait $SECONDS seconds...
A=$(awk '{print $10}' /sys/block/$1/stat)
sleep $SECONDS
B=$(awk '{print $10}' /sys/block/$1/stat)
echo "A: $A, B: $B"
echo "bytes/s: $(( ( $B - $A ) * 512 / 60 ))"

